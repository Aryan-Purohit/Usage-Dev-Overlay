{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\imgui-resources\\imgui.cpp",
                "${workspaceFolder}\\imgui-resources\\imgui_draw.cpp",
                "${workspaceFolder}\\imgui-resources\\imgui_tables.cpp",
                "${workspaceFolder}\\imgui-resources\\imgui_widgets.cpp",
                "${workspaceFolder}\\imgui-resources\\imgui_impl_win32.cpp",
                "${workspaceFolder}\\imgui-resources\\imgui_impl_dx11.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}